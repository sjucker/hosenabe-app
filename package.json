{
  "name": "hosenabe-app",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "run-p dev:**",
    "dev:server": "ts-node-dev src/server.ts",
    "dev:client": "cd client && npm run start",
    "build:server": "npm run build-ts",
    "build:app": "cd client && npm run build",
    "start": "npm run build-ts && node dist/server.js",
    "build-ts": "tsc",
    "test": "echo \"Error: no test specified\" && exit 0",
    "heroku-postbuild": "cd client && npm install && npm install --only=dev --no-shrinkwrap && npm run build",
    "build": "npm run build:app && npm run build:server",
    "clean-install": "npm ci && cd client && npm ci"
  },
  "author": "JuJu",
  "license": "ISC",
  "dependencies": {
    "@types/express": "^5.0.0",
    "express": "^5.0.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "npm-run-all": "^4.1.5",
    "ts-node-dev": "^2.0.0"
  }
}
